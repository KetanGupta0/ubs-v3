###############################################################################
# Application
###############################################################################
APP_NAME="Unboundbyte Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

###############################################################################
# Company details used on invoices, certificates and outbound messages
#
# Starting values only. Once the settings screen has been saved, what is stored
# there wins, so changing these afterwards does nothing.
###############################################################################
COMPANY_NAME="Unboundbyte Solutions"
COMPANY_LEGAL_NAME="Unboundbyte Solutions Private Limited"
COMPANY_EMAIL=hello@unboundbyte.com
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_GSTIN=
COMPANY_CIN=
COMPANY_PAN=

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database
#
# MySQL is the target for every environment. SQLite is fine for a quick local
# run, but migrations are written against MySQL, so test on MySQL before
# shipping.
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unboundbyte
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Sessions, cache and queues
#
# Redis in any environment that runs a worker. The database drivers below are
# a zero dependency fallback for a fresh checkout.
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
# On shared hosting there is no queue worker: set this to true and add one
# cron entry, `* * * * * php /path/to/artisan schedule:run`, which then drains
# the queue every minute.
QUEUE_FROM_SCHEDULER=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Broadcasting — Laravel Reverb powers the chat in Phase 6
###############################################################################
# Run the socket server with `php artisan reverb:start`. Chat still works
# without it — the browser falls back to polling — but it stops being live.
# These three are obvious local placeholders; production sets real ones.
BROADCAST_CONNECTION=reverb
# Shared hosting (Hostinger) cannot run `reverb:start`. There, use a hosted
# service that speaks the Pusher protocol: set BROADCAST_CONNECTION=pusher,
# VITE_BROADCASTER=pusher and the PUSHER_* values below, then rebuild assets.
# Without either, chat still works by polling and says it is not live.
VITE_BROADCASTER=reverb
# Production uses Pusher Channels (decided 2026-11-12). Create the app in Pusher's
# dashboard with the Mumbai cluster (ap2) and copy its keys here; never commit them.
#PUSHER_APP_ID=
#PUSHER_APP_KEY=
#PUSHER_APP_SECRET=
#PUSHER_APP_CLUSTER=ap2
#VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
#VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
REVERB_APP_ID=unboundbyte
REVERB_APP_KEY=unboundbyte-local-key
REVERB_APP_SECRET=unboundbyte-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

###############################################################################
# Storage — S3 compatible in production, local disk in development
###############################################################################
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@unboundbyte.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# SMS — MSG91, used for one time codes and client welcome credentials (Phase 1)
###############################################################################
SMS_DRIVER=log
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_ROUTE=4

###############################################################################
# Google sign in (Phase 1) and Meet links for live classes (Phase 5)
###############################################################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

###############################################################################
# Payments — Razorpay (Phase 4)
###############################################################################
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

###############################################################################
# "Are you a person" check on registration forms — Cloudflare Turnstile
# Optional. Off while either is empty; the honeypot and rate limits apply
# either way. Mention Cloudflare in the privacy policy before switching it on.
###############################################################################
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

###############################################################################
# Push notifications for the mobile apps (Phase 8)
###############################################################################
FCM_SERVER_KEY=
FCM_PROJECT_ID=

###############################################################################
# Frontend
###############################################################################
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# The importer's source: a restored copy of the ubs-v2 production dump, never the
# live v2 database. See docs/MIGRATION_PLAN.md. Only needed on the machine that
# runs php artisan legacy:import.
#LEGACY_DB_HOST=127.0.0.1
#LEGACY_DB_PORT=3306
#LEGACY_DB_DATABASE=ubs_v2_copy
#LEGACY_DB_USERNAME=readonly
#LEGACY_DB_PASSWORD=
