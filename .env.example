###############################################################################
# Application
###############################################################################
APP_NAME="Unboundbyte Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

###############################################################################
# Company details used on invoices, certificates and outbound messages
###############################################################################
COMPANY_NAME="Unboundbyte Solutions Private Limited"
COMPANY_EMAIL=hello@unboundbyte.com
COMPANY_PHONE=
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_CIN=

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database
#
# MySQL is the target for every environment. SQLite is fine for a quick local
# run, but migrations are written against MySQL, so test on MySQL before
# shipping.
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unboundbyte
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Sessions, cache and queues
#
# Redis in any environment that runs a worker. The database drivers below are
# a zero dependency fallback for a fresh checkout.
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Broadcasting — Laravel Reverb powers the chat in Phase 6
###############################################################################
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

###############################################################################
# Storage — S3 compatible in production, local disk in development
###############################################################################
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@unboundbyte.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# SMS — MSG91, used for one time codes and client welcome credentials (Phase 1)
###############################################################################
SMS_DRIVER=log
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_ROUTE=4

###############################################################################
# Google sign in (Phase 1) and Meet links for live classes (Phase 5)
###############################################################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

###############################################################################
# Payments — Razorpay (Phase 4)
###############################################################################
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

###############################################################################
# Push notifications for the mobile apps (Phase 8)
###############################################################################
FCM_SERVER_KEY=
FCM_PROJECT_ID=

###############################################################################
# Frontend
###############################################################################
VITE_APP_NAME="${APP_NAME}"
